# Formspree form endpoint for the Contact section (create a form at https://formspree.io).
# Local dev: copy this file to .env.local and put your real endpoint in it.
# Deployed site: add a repo *variable* named VITE_FORMSPREE_ENDPOINT
#   (GitHub: Settings > Secrets and variables > Actions > Variables).
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
